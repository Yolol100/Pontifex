        'vca_proefexamen_en'     => ['label' => 'Practice exams',              'price' => 25.00],
        'vca_elearning_en'       => ['label' => 'E-learning with practice exam','price' => 49.00],
        'boek_basis_en'          => ['label' => 'Book',                         'price' => 56.00],
